---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  interactiveBackground?: boolean;
}

const { title, description = "Senior iOS engineer portfolio.", interactiveBackground = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const pathname = Astro.url.pathname;
const showCaseBackNav = pathname.includes("/case-studies");
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body class={interactiveBackground ? "has-interactive-bg" : undefined}>
    <main class="container">
      {
        showCaseBackNav && (
          <nav class="case-back-bar" aria-label="Portfolio">
            <a href={baseUrl} class="case-back-link">
              <span class="case-back-arrow" aria-hidden="true">←</span>
              Back to home
            </a>
          </nav>
        )
      }
      <slot />
    </main>
    {interactiveBackground && (
      <script is:inline>
        const root = document.documentElement;
        let targetX = window.innerWidth * 0.5;
        let targetY = window.innerHeight * 0.45;
        let currentX = targetX;
        let currentY = targetY;

        const setTargets = (event) => {
          targetX = event.clientX;
          targetY = event.clientY;
        };

        const render = () => {
          // Keep cursor influence subtle and organic.
          currentX += (targetX - currentX) * 0.045;
          currentY += (targetY - currentY) * 0.045;

          const w = window.innerWidth || 1;
          const h = window.innerHeight || 1;
          const nx = currentX / w;
          const ny = currentY / h;
          const t = performance.now() * 0.00018;
          const driftX = Math.sin(t) * 70;
          const driftY = Math.cos(t * 1.3) * 55;

          root.style.setProperty("--mouse-x", `${currentX + driftX * 0.35}px`);
          root.style.setProperty("--mouse-y", `${currentY + driftY * 0.35}px`);
          root.style.setProperty("--mouse-x-2", `${(1 - nx * 0.66) * w + Math.cos(t * 0.8) * 90}px`);
          root.style.setProperty("--mouse-y-2", `${(0.16 + ny * 0.56) * h + Math.sin(t * 1.1) * 65}px`);
          root.style.setProperty("--mouse-x-3", `${(0.2 + nx * 0.64) * w + Math.sin(t * 0.95) * 80}px`);
          root.style.setProperty("--mouse-y-3", `${(1 - ny * 0.7) * h + Math.cos(t * 1.2) * 60}px`);

          requestAnimationFrame(render);
        };

        window.addEventListener("pointermove", setTargets, { passive: true });
        requestAnimationFrame(render);
      </script>
    )}
  </body>
</html>
